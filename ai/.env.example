# Google Gemini API Key
# Required for generating narratives, intelligence, and recommendations.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Rate Limiting & Batching Configuration
GEMINI_MAX_RPM=15
GEMINI_RATE_WINDOW=60
GEMINI_MAX_BATCH_SIZE=5
GEMINI_MAX_RETRIES=3
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite

# Groq API Key
# Required for narrative topic assignment.
GROQ_API_KEY=your_groq_api_key_here
# Configurable Groq topic model: allam-2-7b (7B SLM, default) or openai/gpt-oss-20b (fallback)
GROQ_TOPIC_MODEL=allam-2-7b

# Groq Rate Limiting Configuration
GROQ_MAX_RPM=30
GROQ_RATE_WINDOW=60
GROQ_MAX_RETRIES=3
